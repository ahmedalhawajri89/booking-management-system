# Copy to .env.local and fill in to run against the Laravel API.
# With this unset the app runs on localStorage with seeded demo data — that
# is the default, and it needs no setup at all.
#
# Everything with a VITE_ prefix is compiled into the bundle and served to
# every visitor. Only put values here that are safe to publish.

# Where api/ is served from. Public by definition — it is the address the
# browser calls. Nothing that protects the data lives on this side: the
# policies and the booking transaction are in api/, and there is no key to
# ship, which is the one thing this arrangement has over the previous one.
VITE_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# The backend's own secrets — APP_KEY, DB_PASSWORD, mail credentials — belong
# in api/.env and nowhere else. Never give one a VITE_ prefix: that compiles
# it into the bundle and serves it to every visitor.
#
# scripts/check-secrets.mjs fails the build if one appears under src/.
# ---------------------------------------------------------------------------
