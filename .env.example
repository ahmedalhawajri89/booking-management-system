# Copy to .env.local and fill in to run against Supabase.
# With these unset the app runs on localStorage with seeded demo data — that
# is the default, and it needs no setup at all.
#
# Everything with a VITE_ prefix is compiled into the bundle and served to
# every visitor. Only put values here that are safe to publish.

# Public by design. RLS is what protects the data — see supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The organization row this deployment serves.
VITE_SUPABASE_ORG_ID=

# ---------------------------------------------------------------------------
# NEVER put the service role key in this file or anywhere under src/.
#
#   SUPABASE_SERVICE_ROLE_KEY=...   ← belongs in Edge Function secrets only
#
# It bypasses Row Level Security completely. Prefixed with VITE_ it would be
# shipped to the browser, and every policy in supabase/migrations/0005 would
# be decoration. scripts/check-secrets.mjs fails the build if it appears.
# ---------------------------------------------------------------------------
